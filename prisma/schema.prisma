generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  FOH
  KITCHEN
  BAR
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  firstName    String
  lastName     String
  pictureUrl   String?
  fullName     String
  password     String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  isActive     Boolean        @default(true)
  isVerified   Boolean        @default(false)
  verifiedAt   DateTime?
  verifiedBy   String?
  activities   UserActivity[]
  department   Department?    @relation("UserDepartment", fields: [departmentId], references: [id])
  departmentId String?
  location     Location?      @relation("UserLocation", fields: [locationId], references: [id])
  locationId   String?
  managedLocations Location[] @relation("LocationManager")
  shiftTemplates  ShiftTemplate[]  @relation("ShiftTemplateAssignee")
  shiftInstances  ShiftInstance[]  @relation("ShiftInstanceAssignee")
  attendances     ShiftAttendance[]
  timeOffRequests         TimeOffRequest[] @relation("TimeOffRequester")
  reviewedTimeOffRequests TimeOffRequest[] @relation("TimeOffReviewer")
  serviceEvents           ServiceEvent[]
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  timestamp    DateTime @default(now())
  activity     Activity
  activityData Json?

  @@index([userId])
  @@index([timestamp])
}

model Department {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  users       User[]    @relation("UserDepartment")
}

model Location {
  id            String    @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isActive      Boolean   @default(true)
  minimumStaff  Int       @default(0)
  manager       User?     @relation("LocationManager", fields: [managerId], references: [id])
  managerId     String?
  users         User[]    @relation("UserLocation")
  shiftTemplates ShiftTemplate[]
  shiftInstances ShiftInstance[]
  attendances    ShiftAttendance[]
  diningTables   DiningTable[]
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FULL_DAY
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ShiftTemplate {
  id         String          @id @default(uuid())
  locationId String
  location   Location        @relation(fields: [locationId], references: [id])
  userId     String
  user       User            @relation("ShiftTemplateAssignee", fields: [userId], references: [id])
  type       ShiftType
  startTime  String
  endTime    String
  weekdays   Int[]
  notes      String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  instances  ShiftInstance[]

  @@index([locationId])
  @@index([userId])
}

model ShiftInstance {
  id         String         @id @default(uuid())
  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id])
  locationId String
  location   Location       @relation(fields: [locationId], references: [id])
  userId     String
  user       User           @relation("ShiftInstanceAssignee", fields: [userId], references: [id])
  date       DateTime
  type       ShiftType
  startTime  String
  endTime    String
  status     ShiftStatus    @default(SCHEDULED)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  attendances ShiftAttendance[]

  @@index([locationId, date])
  @@index([userId, date])
  @@index([templateId])
}

model ShiftAttendance {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  shiftInstanceId String?
  shiftInstance   ShiftInstance? @relation(fields: [shiftInstanceId], references: [id])
  locationId      String?
  location        Location?      @relation(fields: [locationId], references: [id])
  checkInAt       DateTime
  checkOutAt      DateTime?
  /** Minutes on the clock; set when checking out. */
  durationMinutes Int?
  checkInActivityId  String?
  checkOutActivityId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, checkInAt])
  @@index([locationId, checkInAt])
  @@index([shiftInstanceId])
}

enum TimeOffType {
  TIME_OFF
  SICK
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TimeOffRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("TimeOffRequester", fields: [userId], references: [id])
  type         TimeOffType
  status       TimeOffStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  note         String?
  reviewedById String?
  reviewedBy   User?         @relation("TimeOffReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([userId, status])
  @@index([status, startDate])
}

enum Activity {
  LOGIN
  LOGOUT
  REGISTER
  VERIFY
  UNVERIFY
  SHIFT_TEMPLATE_CREATE
  SHIFT_TEMPLATE_UPDATE
  SHIFT_TEMPLATE_DELETE
  SHIFT_TEMPLATE_GENERATE
  SHIFT_INSTANCE_CREATE
  SHIFT_INSTANCE_UPDATE
  SHIFT_INSTANCE_DELETE
  SHIFT_CHECK_IN
  SHIFT_CHECK_OUT
  PROFILE_UPDATE
  TIME_OFF_REQUEST
  TIME_OFF_APPROVE
  TIME_OFF_REJECT
  TIME_OFF_CANCEL
  SERVICE_ITEMS_ADDED
  SERVICE_COURSE_FIRED
  SERVICE_COURSE_PICKED_UP
  SERVICE_DRINKS_PICKED_UP
  SERVICE_COURSE_DELIVERED
  SERVICE_BILL_REQUESTED
  SERVICE_PAYMENT_COMPLETED
  SERVICE_TABLE_CLEARED
}

enum CatalogItemKind {
  FOOD
  DRINK
}

enum CatalogCategory {
  STARTER
  MAIN
  DESSERT
  DRINK
}

enum ProductionStation {
  GRILL
  HOT_KITCHEN
  COLD_KITCHEN
  BAR
}

enum ItemProductionStatus {
  HELD
  QUEUED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
}

enum ServiceEventType {
  TABLE_SEATED
  ORDER_SUBMITTED
  COURSE_FIRED
  ITEM_RELEASED
  ITEM_PREPARING
  ITEM_READY
  ITEM_UNDO_READY
  COURSE_PICKED_UP
  DRINKS_PICKED_UP
  COURSE_DELIVERED
  ITEM_ADDED
  BILL_REQUESTED
  PAYMENT_COMPLETED
  TABLE_CLEARED
}

model CatalogItem {
  id        String           @id @default(uuid())
  name      String
  kind      CatalogItemKind
  category  CatalogCategory
  station   ProductionStation
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  orderItems OrderItem[]

  @@unique([name])
  @@index([kind, category])
}

model DiningTable {
  id         String    @id @default(uuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  number     Int
  seatCount  Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  orders     Order[]

  @@unique([locationId, number])
  @@index([locationId])
}

model Order {
  id               String         @id @default(uuid())
  tableId          String
  table            DiningTable    @relation(fields: [tableId], references: [id])
  covers           Int
  submittedAt      DateTime?
  billRequestedAt  DateTime?
  paidAt           DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  courses          Course[]
  items            OrderItem[]
  events           ServiceEvent[]

  @@index([tableId, closedAt])
}

model Course {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  sequence    Int
  firedAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@index([orderId, sequence])
}

model OrderItem {
  id                String                @id @default(uuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId          String?
  course            Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  catalogItemId     String
  catalogItem       CatalogItem           @relation(fields: [catalogItemId], references: [id])
  name              String
  kind              CatalogItemKind
  station           ProductionStation
  quantity          Int                   @default(1)
  productionStatus  ItemProductionStatus
  orderedAt         DateTime
  releasedAt        DateTime?
  preparingAt       DateTime?
  readyAt           DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([orderId, productionStatus])
  @@index([courseId])
  @@index([station, productionStatus])
}

model ServiceEvent {
  id          String            @id @default(uuid())
  type        ServiceEventType
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableId     String
  courseId    String?
  itemId      String?
  actorUserId String
  actor       User              @relation(fields: [actorUserId], references: [id])
  payload     Json?
  createdAt   DateTime          @default(now())

  @@index([orderId, createdAt])
  @@index([tableId, createdAt])
}
